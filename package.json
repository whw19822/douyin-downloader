{
  "name": "douyin-batch-studio",
  "private": true,
  "version": "1.0.0",
  "description": "抖存批量工作台 · 免内测码抖音批量下载桌面与 Web 应用",
  "author": "Douyin Batch Studio",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "build:electron": "npm run build && node scripts/build-electron.mjs",
    "electron:preview": "npm run build:electron && electron .",
    "dist:mac": "npm run build:electron && electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:mac:arm64": "npm run build:electron && electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:mac:dir": "npm run build:electron && electron-builder --mac --arm64 --dir --config electron-builder.yml",
    "lint": "eslint src server.ts server electron",
    "start": "NODE_ENV=production node server.ts",
    "test": "tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.1"
  }
}
